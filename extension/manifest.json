{
    "manifest_version": 3,
    "name": "IMDB Torrent Search",
    "short_name": "IMDB Torrent Search",
    "description": "A simple extension that displays torrents for IMDB movies and series directly onto the page",
    "version": "2.0.0",
    "background": {
        "service_worker": "build/service-worker.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["https://*.imdb.com/title/*"],
            "css": ["build/content.css"],
            "js": ["build/content.js"],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_title": "IMDB Torrent Search settings",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "img/logo-16x16.png",
            "48": "img/logo-48x48.png",
            "128": "img/logo-128x128.png"
        }
    },
    "icons": {
        "16": "img/logo-16x16.png",
        "48": "img/logo-48x48.png",
        "128": "img/logo-128x128.png"
    },
    "permissions": ["storage"],
    "host_permissions": [
        "https://yts.mx/*",
        "https://movies-api.accel.li/*",
        "https://eztvx.to/*",
        "https://eztv.re/*"
    ],
    "web_accessible_resources": [
        {
            "resources": ["img/logo-16x16.png", "img/icon-magnet.gif", "img/1337x-favicon.png", "img/tpb-favicon.png"],
            "matches": ["https://*.imdb.com/*"]
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}
